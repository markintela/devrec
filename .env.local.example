# Copiar para .env.local e preencher com os dados do projeto Supabase
# (Dashboard → Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-ou-publishable

# Só no servidor. Nunca expor no browser.
SUPABASE_SERVICE_ROLE_KEY=chave-service-role-ou-secret
